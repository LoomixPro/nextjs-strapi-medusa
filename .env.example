# =======================================================
# Docker Compose — Environment Variables (Example Template)
# =======================================================
#
# This file has been reorganized to match the deployment phases in README.md.
# Follow the README step-by-step to know when to fill which values.

# =======================================================
# BEFORE PHASE 1: INITIAL CONFIGURATION
# =======================================================
# You MUST configure this section before running any docker containers.

# -------------------------------------------------------
# 1. Public URLs — pick ONE profile (see README §3)
# -------------------------------------------------------
#
# Local dev (same machine):
STOREFRONT_PUBLIC_URL=http://localhost:8000
MEDUSA_BACKEND_PUBLIC_URL=http://localhost:9000
STRAPI_PUBLIC_URL=http://localhost:1337
MEILISEARCH_PUBLIC_URL=http://127.0.0.1:7700
MINIO_PUBLIC_URL=http://localhost:9001/mystore
GOOGLE_CALLBACK_URL=http://localhost:8000/us/account/auth/callback
#
# Profile A — Quick LAN (HTTP + IP). Skip README Phase 2 (Caddy).
# MEDUSA_ALLOW_HTTP_COOKIES=true required for admin login.
# STOREFRONT_PUBLIC_URL=http://192.168.1.103:8000
# MEDUSA_BACKEND_PUBLIC_URL=http://192.168.1.103:9000
# STRAPI_PUBLIC_URL=http://192.168.1.103:1337
# MINIO_PUBLIC_URL=http://192.168.1.103:9001/mystore
# GOOGLE_CALLBACK_URL=http://192.168.1.103:8000/us/account/auth/callback
#
# Profile B — VM/LAN HTTPS (recommended). Run README Phase 2 before Strapi/Medusa.
# Add VM IP to Windows hosts: store.local api.local admin.local analytics.local
# STOREFRONT_PUBLIC_URL=https://store.local
# MEDUSA_BACKEND_PUBLIC_URL=https://api.local
# STRAPI_PUBLIC_URL=https://admin.local
# MINIO_PUBLIC_URL=https://api.local/minio/mystore
# GOOGLE_CALLBACK_URL=https://store.local/us/account/auth/callback
# MEDUSA_ALLOW_HTTP_COOKIES=false
#
# Profile C — Real public domain (production):
# DOMAIN=yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
# STOREFRONT_PUBLIC_URL=https://yourdomain.com
# MEDUSA_BACKEND_PUBLIC_URL=https://api.yourdomain.com
# STRAPI_PUBLIC_URL=https://admin.yourdomain.com
# MINIO_PUBLIC_URL=https://api.yourdomain.com/minio/mystore
# GOOGLE_CALLBACK_URL=https://yourdomain.com/us/account/auth/callback
# MEILISEARCH_PUBLIC_URL stays http://127.0.0.1:7700 — never add a search.* domain

# -------------------------------------------------------
# 2. Secrets (Generate via: openssl rand -hex 32)
# -------------------------------------------------------
POSTGRES_PASSWORD=your_postgres_password_here
MEILI_MASTER_KEY=your_meili_master_key_here
STRAPI_API_TOKEN_SALT=your_api_token_salt_here
STRAPI_ADMIN_JWT_SECRET=your_admin_jwt_secret_here
STRAPI_TRANSFER_TOKEN_SALT=your_transfer_token_salt_here
STRAPI_JWT_SECRET=your_jwt_secret_here
STRAPI_ENCRYPTION_KEY=your_encryption_key_here
MEDUSA_JWT_SECRET=your_medusa_jwt_secret_here
MEDUSA_COOKIE_SECRET=your_medusa_cookie_secret_here
REVALIDATE_SECRET=your_revalidate_secret_here
UMAMI_APP_SECRET=your_umami_app_secret_here
INTERNAL_API_SECRET=your_internal_api_secret_here
AUTH_MFA_ENCRYPTION_KEY=your_auth_mfa_encryption_key_here
STRAPI_APP_KEYS=your_app_key_1,your_app_key_2

# -------------------------------------------------------
# 3. Admin Credentials
# -------------------------------------------------------
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=your_admin_password_here
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
UMAMI_USERNAME=admin
UMAMI_PASSWORD=your_umami_password_here
OPENOBSERVE_ROOT_USER_EMAIL=admin@example.com
OPENOBSERVE_ROOT_USER_PASSWORD=Complexpass#123
# Caddy HTTP Basic Auth (Protects Strapi Admin Panel and OpenObserve Dashboard)
# Generate a new bcrypt hash via: docker run --rm caddy:latest caddy hash-password --plaintext "your_password"
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=$2a$14$5y/bX4mNtIj3Svb76Ria4eRekRIfEHFCYNE1ZyiBPeXYlj41rVvO.


# -------------------------------------------------------
# 4. Base Configuration (Defaults are usually fine)
# -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_MAX_CONNECTIONS=500

STRAPI_NODE_ENV=production
STRAPI_DATABASE_CLIENT=postgres
STRAPI_DATABASE_SSL=false
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337

MEDUSA_NODE_ENV=production
# Profile A (HTTP + IP): true — admin login at http://<IP>:9000/app
# Profile B/C (HTTPS via Caddy): false
MEDUSA_ALLOW_HTTP_COOKIES=false
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Comma-separated allowed origins. In Docker, defaults are derived from public URLs above.
# Override to allow multiple origins (e.g. localhost + production during migration):
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:1337
AUTH_CORS=http://localhost:8000,http://localhost:9000

MEILISEARCH_INDEX_NAME=products
MEILISEARCH_NO_ANALYTICS=true
MEILISEARCH_ENV=production

MINIO_REGION=us-east-1
MINIO_BUCKET=mystore
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

DEFAULT_REGION=US
DEFAULT_LOCALE=en-US
ENABLE_IRAN_FEATURES=false
CADDY_ROOT_CA_PATH=/caddy-data/pki/authorities/local/root.crt

# Internal URLs (Docker Compose internal network — DO NOT CHANGE)
STOREFRONT_URL=http://storefront:8000
MEDUSA_BACKEND_URL=http://medusa:9000


# =======================================================
# PHASE 4: STRAPI API TOKENS (Generated in Strapi Admin)
# =======================================================
# See README §8. Generate these in Strapi Admin -> Settings -> API Tokens.
# Generate and set these BEFORE Phase 5 (Medusa).
STRAPI_API_TOKEN_FOR_MEDUSA=
STRAPI_API_TOKEN_FOR_FRONT=


# =======================================================
# PHASE 6: MEDUSA PUBLISHABLE KEY (Generated in Medusa Admin)
# =======================================================
# See README §10. Generate in Medusa Admin -> Settings -> API Keys.
# Generate and set this BEFORE Phase 8 (Storefront).
MEDUSA_PUBLISHABLE_KEY=


# =======================================================
# PHASE 7: MEILISEARCH SEARCH KEY (Generated via Terminal)
# =======================================================
# See README §11. Generate via: curl -H "Authorization: Bearer <MEILI_MASTER_KEY>" http://127.0.0.1:7700/keys
# Generate and set this BEFORE Phase 8 (Storefront).
# MUST NOT equal MEILI_MASTER_KEY.
MEILI_SEARCH_KEY=


# =======================================================
# PHASE 8: UMAMI ANALYTICS (Analytics & Page Views)
# =======================================================
# See README §12. Generate in Umami Admin -> Settings -> Websites.
# Generate and set this BEFORE Phase 9 (Storefront GitHub Build).
UMAMI_WEBSITE_ID=

# Public URL of Umami for browsers to load the tracking script.
# Profile A (Direct Port): http://<VM_IP>:3005
# Profile B (Domain / SSL): https://analytics.yourdomain.com
# Local development: http://localhost:3005
UMAMI_PUBLIC_URL=

# Internal URL used by Next.js Server-Side for fetching view counts.
# Local development only: http://localhost:3000
# On production VPS / Docker: No change needed (Docker Compose automatically routes internally to http://umami:3000).
UMAMI_URL=http://localhost:3000


# =======================================================
# OPTIONAL INTEGRATIONS (Can be left empty or set later)
# =======================================================

# -------------------------------------------------------
# Cloudflare Tunnel (Phase 9)
# -------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# -------------------------------------------------------
# Stripe & Payments (Leave empty for manual testing)
# -------------------------------------------------------
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
MEDUSA_PAYMENTS_ACCOUNT_ID=

# -------------------------------------------------------
# Mail (SMTP - Gmail / Custom)
# -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_ADDRESS=your_email@gmail.com
SMTP_SECURE=false
CONTACT_FORM_RECIPIENT=your_email@gmail.com
SENDPULSE_API_ID=your_sendpulse_api_id_here
SENDPULSE_API_SECRET=your_sendpulse_api_secret_here
SENDPULSE_BOOK_ID=your_book_id_here

# -------------------------------------------------------
# SMS Configuration
# -------------------------------------------------------
SMS_PROVIDER=sms-ir
SMS_API_KEY=your_sms_api_key_here
SMS_OTP_TEMPLATE_ID=123456
SMS_ORDER_PLACED_TEMPLATE_ID=123457
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# -------------------------------------------------------
# Google Auth & GTM
# -------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_CALLBACK_URL is defined at the top in Public URLs section
GTM_ID=GTM-XXXXXXX

# -------------------------------------------------------
# Component Registry / Loomix Blocks (Open Ecosystem)
# -------------------------------------------------------
# Default: Official public Loomix Blocks component registry (No token required).
# You can also point this to your own custom team registry:
REGISTRY_URL=https://raw.githubusercontent.com/Loomix-pro/Loomix-registry/main/src/modules
# Optional: Set GITHUB_PAT only if you point REGISTRY_URL to your own private GitHub repository:
# GITHUB_PAT=github_pat_your_token_here

# -------------------------------------------------------
# Strapi Storefront Deployment (CI/CD Integration)
# -------------------------------------------------------
# GitHub Personal Access Token (Classic PAT with 'repo' scope).
# Required by Strapi CMS backend to trigger the 'Update Storefront' GitHub Actions workflow:
GITHUB_DEPLOY_TOKEN=github_pat_your_actions_dispatch_token

# Your storefront repository in GitHub (format: <owner>/<repo>):
GITHUB_DEPLOY_REPO=<your-github-username>/<your-repo-name>

# The absolute path to this project folder on your Linux VPS (run `pwd` inside the project folder on your VPS to get it).
# Required by GitHub Actions Self-Hosted Runner during production deployment:
# Example: DEPLOY_PATH=/home/ubuntu/next-strapi-medusa or /root/next-strapi-medusa
DEPLOY_PATH=/home/<your-linux-username>/<your-project-folder>