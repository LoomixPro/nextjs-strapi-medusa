    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.2"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 16",
    "ios >= 16",
    "not dead"
  ]
}
