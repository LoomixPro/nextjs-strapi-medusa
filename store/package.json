{
  "name": "loomix-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Loomix Commerce Storefront - Next.js 16 + Strapi + Medusa v2",
  "keywords": [
    "loomix",
    "headless-commerce",
    "medusa-storefront",
    "nextjs"
  ],
  "scripts": {
    "dev": "node scripts/generate-style-registries.js && next dev --turbopack -p 8000",
    "build": "node scripts/generate-style-registries.js && next build",
    "sync:translations": "node ../scripts/sync-translations.js",
    "sync:settings": "node ../scripts/sync-settings.js",
    "postbuild": "next-sitemap",
    "start": "next start -p 8000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "next experimental-analyze -o",
    "analyze:open": "next experimental-analyze",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@headlessui/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@medusajs/icons": "2.15.5",
    "@medusajs/js-sdk": "2.15.5",
    "@medusajs/ui": "4.1.15",
    "@meilisearch/instant-meilisearch": "^0.30.0",
    "@next/third-parties": "16.3.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^1.0.12",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "country-state-city": "^3.2.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.1",
    "iran-city": "^1.2.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.563.0",
    "next": "16.3.0",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.1.0",
    "qs": "^6.12.1",
    "react": "19.2.8",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.77.0",
    "react-instantsearch": "^7.35.1",
    "react-phone-number-input": "^3.4.14",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "tailwindcss-radix": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@eslint/eslintrc": "^3.3.6",
    "@medusajs/types": "2.15.5",
    "@medusajs/ui-preset": "2.15.5",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.195",
    "@types/node": "17.0.21",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-instantsearch-dom": "^6.12.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "babel-loader": "^8.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.8",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.8",
    "prettier": "^3.9.6",
