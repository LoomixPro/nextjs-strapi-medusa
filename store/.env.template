# Your Medusa backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server. See – https://docs.medusajs.com/learn/configurations/medusa-config#httpstorecors
MEDUSA_BACKEND_URL=http://localhost:9000

# Redis URL — used by the rate limiter for multi-instance correctness.
# Should point to the same Redis instance that Medusa uses.
REDIS_URL=redis://127.0.0.1:6379

# Your publishable key that can be attached to sales channels. See - https://docs.medusajs.com/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your preferred default region. When middleware cannot determine the user region from the "x-vercel-country" header, the default region will be used. ISO-2 lowercase format. 
NEXT_PUBLIC_DEFAULT_REGION=us
DEFAULT_LOCALE=en

# Optional Store Branding (falls back to Strapi Storefront Settings or "Loomix")
NEXT_PUBLIC_SITE_NAME=Loomix
NEXT_PUBLIC_SITE_DESCRIPTION="Modern E-Commerce Storefront"

# Enable/Disable Iran-specific features (Rial-to-Toman conversion, Iranian SMS, Iranian provinces/cities)
NEXT_PUBLIC_ENABLE_IRAN_FEATURES=false

# Your Stripe public key. See – https://docs.medusajs.com/resources/commerce-modules/payment/payment-provider/stripe
NEXT_PUBLIC_STRIPE_KEY=

# Your Medusa payments publishable key. You can find it in your Medusa dashbard.
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=

# Your Medusa payments external account ID. You can find it in your Medusa dashbard.
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Your Next.js revalidation secret. See – https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=

# Strapi CMS URL for fetching storefront settings
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Server-side Strapi URL (Docker: http://strapi:1337). Falls back to NEXT_PUBLIC_STRAPI_URL.
STRAPI_URL=

# Strapi API Token for authentication
STRAPI_API_TOKEN=

# For Cloud users: add your Medusa Cloud S3 hostname and pathname to enable image optimization.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# Meilisearch — use a search-only API key in the browser (never the master/admin key).
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
NEXT_PUBLIC_MEILISEARCH_INDEX_NAME=products
# Server-side Meilisearch (SSR). Prefer internal URL/key; never expose master key via NEXT_PUBLIC_*.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Umami Configuration — credentials are required in production.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Server-side Umami URL (Docker: http://umami:3000). Falls back to NEXT_PUBLIC_UMAMI_URL.
UMAMI_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=

NODE_ENV=development

# SendPulse Newsletter
SENDPULSE_API_ID=
SENDPULSE_API_SECRET=
SENDPULSE_BOOK_ID=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
CONTACT_FORM_RECIPIENT=

# Secret shared with Medusa backend for authenticating internal server-to-server API calls
# Must match INTERNAL_API_SECRET in store-admin/.env
INTERNAL_API_SECRET=

# Component Registry Path (Production: use HTTP URL, Local: use absolute folder path)
REGISTRY_URL=
GITHUB_PAT=
